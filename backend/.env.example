# ============================================================
# UHR — Unified Health Record | Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================================

# --- Azure Document Intelligence ---
DOCUMENT_INTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
DOCUMENT_INTELLIGENCE_KEY=

# --- Azure Text Analytics for Health ---
TEXT_ANALYTICS_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
TEXT_ANALYTICS_KEY=

# --- Azure AI Search ---
SEARCH_ENDPOINT=https://<resource>.search.windows.net
SEARCH_KEY=
SEARCH_INDEX_NAME=uhr-health-records

# --- Azure Blob Storage ---
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
STORAGE_CONTAINER_NAME=health-records

# --- Azure AI Foundry (Claude) ---
ANTHROPIC_BASE_URL=https://<resource>.services.ai.azure.com/anthropic/v1/
ANTHROPIC_API_KEY=

# --- Supabase ---
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Define true para usar mocks locais (sem Azure real)
USE_MOCK_AZURE=true
MOCK_USER_ID=local-dev-user-001
NEXT_PUBLIC_APP_URL=http://localhost:3000
